#!/bin/bash
#
# uws - Universal Workflow System CLI
#
# Usage: uws <command> [args...]
# Run 'uws help' for available commands.
#

set -euo pipefail

# ── Resolve symlinks to find the real UWS installation directory ───────────

resolve_uws_dir() {
    local source="${BASH_SOURCE[0]}"
    while [[ -L "$source" ]]; do
        local dir
        dir="$(cd "$(dirname "$source")" && pwd)"
        source="$(readlink "$source")"
        # Handle relative symlinks
        [[ "$source" != /* ]] && source="$dir/$source"
    done
    cd "$(dirname "$source")/.." && pwd
}

UWS_INSTALL_DIR="$(resolve_uws_dir)"

# The release number has one source: VERSION at the install's root (the plugin ships it
# too); .claude-plugin/plugin.json must carry the same number (tests/unit/test_uws_cli.bats)
UWS_VERSION="$(tr -d '[:space:]' 2>/dev/null < "${UWS_INSTALL_DIR}/VERSION" || true)"
UWS_VERSION="${UWS_VERSION:-unknown}"

# shellcheck source=scripts/lib/uws_ui.sh
source "${UWS_INSTALL_DIR}/scripts/lib/uws_ui.sh"

# The hints the scripts print ("run ... next") name the command that reached them:
# `uws`, or this install's bin/uws by absolute path when `uws` on PATH is another
# install. The plugin copy prints its /uws:<command> slash commands instead.
if ! uws_in_plugin; then
    UWS_CMD="${UWS_CMD:-$(uws_cli_path)}"
    export UWS_CMD
fi

# ── Root discovery ──────────────────────────────────────────────────────────

find_uws_root() {
    # 1. Explicit env var
    if [[ -n "${UWS_ROOT:-}" ]] && [[ -d "${UWS_ROOT}/.workflow" ]]; then
        echo "$UWS_ROOT"
        return 0
    fi

    # 2. Walk up from CWD looking for .workflow/
    local dir="$PWD"
    while [[ "$dir" != "/" ]]; do
        if [[ -d "$dir/.workflow" ]]; then
            echo "$dir"
            return 0
        fi
        dir="$(dirname "$dir")"
    done

    return 1
}

# ── Usage / Help ────────────────────────────────────────────────────────────

show_help() {
    cat <<'EOF'
uws - Universal Workflow System CLI

Usage: uws <command> [args...]

Workflow Commands:
  init [type]              Initialize UWS in current project
  status [-v|-c]           Show workflow status
  checkpoint <cmd> [args]  Manage checkpoints (create|list|restore|status)
  recover                  Recover context after session break
  orchestrate <cmd> [args] Route the current phase to its subagent
                           (dispatch "<task>" | collect "<summary>" | status)
  kb <verb> [args]         Project knowledge base in docs/kb/ (add|search|links|
                           show|verify|recommend|review|approve|reject|dispute|
                           pi|prune|retire|restore|lint|stats|learn|proposals|
                           init|import); --global for the cross-project KB;
                           'uws kb help' for details

Methodology Commands:
  sdlc [cmd]               SDLC workflow (status|start|next|fail|reset)
  research [cmd]           Research workflow (status|start|next|reject|reset)
  research check <name>    Research team evidence checks: init | ledger | bib |
                           quotes | numbers [add] | claims [add] | slop |
                           gate <phase> | plan | data | run | repro | retraction |
                           manuscript-hash | macros (no .workflow needed)
  research bib fetch|build Download authoritative BibTeX into bib_sources/;
                           build references.bib from bib_sources/ only
  spiral [args]            Spiral SDLC workflow

Project Management:
  review [args]            Review/approve code changes
  pm [args]                Project management (issues/board)
  submit [args]            Submit code for review
  detect                   Auto-detect and configure project type
  dashboard                Serve the review/PM dashboard (http://localhost:8080)
  uninstall [opts]         Remove UWS (--project|--global|--all) [--dry-run]

General:
  help                     Show this help message
  version                  Print version

Environment:
  UWS_ROOT                 Override project root discovery

Examples:
  uws init software        Initialize a software project
  uws status               Show current workflow state
  uws checkpoint create "Feature complete"
  uws orchestrate dispatch "Write the requirements"
                           Hand the current phase to its subagent
  uws sdlc next            Advance to next SDLC phase
  uws uninstall --dry-run  Preview what uninstall would remove
  uws uninstall --all      Remove UWS from project + system
EOF
}

# Succeeds when `uws kb <verb> [args]` addresses the global KB, which needs no
# project: --global, --scope global, --scope=global, or a global:K-... ID in an
# ID position. The rule is kb.sh's own (kb_scan_scope_args), so a --quote or
# --claim text that starts with global:K- does not count.
kb_args_global() {
    local lib="${UWS_INSTALL_DIR}/scripts/lib/kb_utils.sh"
    [[ -f "$lib" ]] || return 1
    # shellcheck source=scripts/lib/kb_utils.sh
    source "$lib"
    [[ $# -gt 0 ]] && shift
    kb_scan_scope_args "$@" || return 1
    [[ "$KB_SCAN_SCOPE" == "global" ]]
}

# research_needs_no_state <research args>: true for `bib ...`, for help, and for
# `check` unless it ticks a numbered deliverable (`check <n>`): `check <name>` runs a
# checker command, and a bare `check` or `check help` prints the checks' usage.
research_needs_no_state() {
    case "${1:-}" in
        bib|help|-h|--help) return 0 ;;
        check)
            [[ ! "${2:-}" =~ ^[0-9]+$ ]] && return 0
            ;;
    esac
    return 1
}

# `uws agent` / `uws skill` were retired: agents are real Claude Code
# subagents (.claude/agents/uws-<role>.md) and skills are native Claude Code
# skills, so there is nothing to activate or enable.
retired_command() {
    echo "uws $1: retired. Agents are Claude Code subagents: run '$(uws_hint orchestrate dispatch '"<task>"')' or use /agents. Skills are native Claude Code skills." >&2
    exit 2
}

# ── Main dispatch ───────────────────────────────────────────────────────────

main() {
    local cmd="${1:-help}"
    shift 2>/dev/null || true

    # Commands that don't need a UWS root
    case "$cmd" in
        help|-h|--help)
            show_help
            exit 0
            ;;
        version|-V|--version)
            echo "uws $UWS_VERSION"
            exit 0
            ;;
        init)
            # init doesn't need .workflow/ to exist yet — find scripts via resolved install dir
            if [[ -x "$UWS_INSTALL_DIR/scripts/init_workflow.sh" ]]; then
                # A global `uws` is already on PATH, so the per-project ./uws wrapper is redundant
                UWS_NO_WRAPPER="${UWS_NO_WRAPPER:-true}" "$UWS_INSTALL_DIR/scripts/init_workflow.sh" "$@"
            else
                echo "Error: Cannot find init_workflow.sh relative to uws binary." >&2
                exit 1
            fi
            exit $?
            ;;
        agent|skill)
            retired_command "$cmd"
            ;;
        kb)
            # The global knowledge base lives outside any project
            if ! find_uws_root >/dev/null 2>&1 && kb_args_global "$@"; then
                exec "$UWS_INSTALL_DIR/scripts/kb.sh" "$@"
            fi
            ;;
        uninstall)
            # uninstall doesn't need .workflow/ — find scripts via resolved install dir
            if [[ -x "$UWS_INSTALL_DIR/scripts/uninstall.sh" ]]; then
                "$UWS_INSTALL_DIR/scripts/uninstall.sh" "$@"
            else
                echo "Error: Cannot find uninstall.sh relative to uws binary." >&2
                exit 1
            fi
            exit $?
            ;;
    esac

    # Find UWS root
    local root
    if ! root="$(find_uws_root)"; then
        # The research evidence checks (`research check <name>`) and the BibTeX fetcher
        # (`research bib`) work from the project files alone (docs/design/research-team.md
        # section 6.6), so they run here without a .workflow; research.sh finds the project
        # from the current directory and refuses the actions that need workflow state.
        if [[ "$cmd" == "research" ]] && research_needs_no_state "$@"; then
            exec "$UWS_INSTALL_DIR/scripts/research.sh" "$@"
        fi
        echo "Error: No UWS project found (no .workflow/ directory)." >&2
        echo "Run 'uws init' inside your project to get started." >&2
        exit 1
    fi

    # Scripts live in the UWS installation; state lives in the user's project.
    local scripts_dir="$UWS_INSTALL_DIR/scripts"
    export WORKFLOW_DIR="$root/.workflow"

    # Change to project root so scripts work correctly
    cd "$root"

    case "$cmd" in
        init)
            "$scripts_dir/init_workflow.sh" "$@"
            ;;
        status)
            "$scripts_dir/status.sh" "$@"
            ;;
        checkpoint)
            "$scripts_dir/checkpoint.sh" "$@"
            ;;
        recover)
            "$scripts_dir/recover_context.sh" "$@"
            ;;
        orchestrate)
            "$scripts_dir/orchestrate.sh" "$@"
            ;;
        kb)
            "$scripts_dir/kb.sh" "$@"
            ;;
        sdlc)
            "$scripts_dir/sdlc.sh" "$@"
            ;;
        research)
            "$scripts_dir/research.sh" "$@"
            ;;
        spiral)
            "$scripts_dir/spiral.sh" "$@"
            ;;
        review)
            "$scripts_dir/review.sh" "$@"
            ;;
        pm)
            "$scripts_dir/pm.sh" "$@"
            ;;
        submit)
            "$scripts_dir/submit.sh" "$@"
            ;;
        detect)
            "$scripts_dir/detect_and_configure.sh" "$@"
            ;;
        dashboard)
            "$scripts_dir/start_dashboard.sh" "$@"
            ;;
        *)
            echo "Unknown command: $cmd" >&2
            echo "Run 'uws help' for available commands." >&2
            exit 1
            ;;
    esac
}

main "$@"
