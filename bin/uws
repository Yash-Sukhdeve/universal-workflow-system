#!/bin/bash
#
# uws - Universal Workflow System CLI
#
# Usage: uws <command> [args...]
# Run 'uws help' for available commands.
#

set -euo pipefail

UWS_VERSION="1.1.0"

# ── Resolve symlinks to find the real UWS installation directory ───────────

resolve_uws_dir() {
    local source="${BASH_SOURCE[0]}"
    while [[ -L "$source" ]]; do
        local dir
        dir="$(cd "$(dirname "$source")" && pwd)"
        source="$(readlink "$source")"
        # Handle relative symlinks
        [[ "$source" != /* ]] && source="$dir/$source"
    done
    cd "$(dirname "$source")/.." && pwd
}

UWS_INSTALL_DIR="$(resolve_uws_dir)"

# ── Root discovery ──────────────────────────────────────────────────────────

find_uws_root() {
    # 1. Explicit env var
    if [[ -n "${UWS_ROOT:-}" ]] && [[ -d "${UWS_ROOT}/.workflow" ]]; then
        echo "$UWS_ROOT"
        return 0
    fi

    # 2. Walk up from CWD looking for .workflow/
    local dir="$PWD"
    while [[ "$dir" != "/" ]]; do
        if [[ -d "$dir/.workflow" ]]; then
            echo "$dir"
            return 0
        fi
        dir="$(dirname "$dir")"
    done

    return 1
}

# ── Usage / Help ────────────────────────────────────────────────────────────

show_help() {
    cat <<'EOF'
uws - Universal Workflow System CLI

Usage: uws <command> [args...]

Workflow Commands:
  init [type]              Initialize UWS in current project
  status [-v|-c]           Show workflow status
  checkpoint <cmd> [args]  Manage checkpoints (create|list|restore|status)
  recover                  Recover context after session break
  orchestrate <cmd> [args] Route the current phase to its subagent
                           (dispatch "<task>" | collect "<summary>" | status)

Methodology Commands:
  sdlc [cmd]               SDLC workflow (status|start|next|fail|reset)
  research [cmd]           Research workflow (status|start|next|reject|reset)
  spiral [args]            Spiral SDLC workflow

Project Management:
  review [args]            Review/approve code changes
  pm [args]                Project management (issues/board)
  submit [args]            Submit code for review
  detect                   Auto-detect and configure project type
  dashboard                Serve the review/PM dashboard (http://localhost:8080)
  uninstall [opts]         Remove UWS (--project|--global|--all) [--dry-run]

General:
  help                     Show this help message
  version                  Print version

Environment:
  UWS_ROOT                 Override project root discovery

Examples:
  uws init software        Initialize a software project
  uws status               Show current workflow state
  uws checkpoint create "Feature complete"
  uws orchestrate dispatch "Write the requirements"
                           Hand the current phase to its subagent
  uws sdlc next            Advance to next SDLC phase
  uws uninstall --dry-run  Preview what uninstall would remove
  uws uninstall --all      Remove UWS from project + system
EOF
}

# `uws agent` / `uws skill` were retired: agents are real Claude Code
# subagents (.claude/agents/uws-<role>.md) and skills are native Claude Code
# skills, so there is nothing to activate or enable.
retired_command() {
    echo "uws $1: retired. Agents are Claude Code subagents: run 'uws orchestrate dispatch \"<task>\"' or use /agents. Skills are native Claude Code skills." >&2
    exit 2
}

# ── Main dispatch ───────────────────────────────────────────────────────────

main() {
    local cmd="${1:-help}"
    shift 2>/dev/null || true

    # Commands that don't need a UWS root
    case "$cmd" in
        help|-h|--help)
            show_help
            exit 0
            ;;
        version|-V|--version)
            echo "uws $UWS_VERSION"
            exit 0
            ;;
        init)
            # init doesn't need .workflow/ to exist yet — find scripts via resolved install dir
            if [[ -x "$UWS_INSTALL_DIR/scripts/init_workflow.sh" ]]; then
                # A global `uws` is already on PATH, so the per-project ./uws wrapper is redundant
                UWS_NO_WRAPPER="${UWS_NO_WRAPPER:-true}" "$UWS_INSTALL_DIR/scripts/init_workflow.sh" "$@"
            else
                echo "Error: Cannot find init_workflow.sh relative to uws binary." >&2
                exit 1
            fi
            exit $?
            ;;
        agent|skill)
            retired_command "$cmd"
            ;;
        uninstall)
            # uninstall doesn't need .workflow/ — find scripts via resolved install dir
            if [[ -x "$UWS_INSTALL_DIR/scripts/uninstall.sh" ]]; then
                "$UWS_INSTALL_DIR/scripts/uninstall.sh" "$@"
            else
                echo "Error: Cannot find uninstall.sh relative to uws binary." >&2
                exit 1
            fi
            exit $?
            ;;
    esac

    # Find UWS root
    local root
    if ! root="$(find_uws_root)"; then
        echo "Error: No UWS project found (no .workflow/ directory)." >&2
        echo "Run 'uws init' inside your project to get started." >&2
        exit 1
    fi

    # Scripts live in the UWS installation; state lives in the user's project.
    local scripts_dir="$UWS_INSTALL_DIR/scripts"
    export WORKFLOW_DIR="$root/.workflow"

    # Change to project root so scripts work correctly
    cd "$root"

    case "$cmd" in
        init)
            "$scripts_dir/init_workflow.sh" "$@"
            ;;
        status)
            "$scripts_dir/status.sh" "$@"
            ;;
        checkpoint)
            "$scripts_dir/checkpoint.sh" "$@"
            ;;
        recover)
            "$scripts_dir/recover_context.sh" "$@"
            ;;
        orchestrate)
            "$scripts_dir/orchestrate.sh" "$@"
            ;;
        sdlc)
            "$scripts_dir/sdlc.sh" "$@"
            ;;
        research)
            "$scripts_dir/research.sh" "$@"
            ;;
        spiral)
            "$scripts_dir/spiral.sh" "$@"
            ;;
        review)
            "$scripts_dir/review.sh" "$@"
            ;;
        pm)
            "$scripts_dir/pm.sh" "$@"
            ;;
        submit)
            "$scripts_dir/submit.sh" "$@"
            ;;
        detect)
            "$scripts_dir/detect_and_configure.sh" "$@"
            ;;
        dashboard)
            "$scripts_dir/start_dashboard.sh" "$@"
            ;;
        *)
            echo "Unknown command: $cmd" >&2
            echo "Run 'uws help' for available commands." >&2
            exit 1
            ;;
    esac
}

main "$@"
