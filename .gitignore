.workflow/snapshots/*
!.workflow/snapshots/.gitkeep
.workflow/*.tmp
.workflow/skills/execution_logs/*
!.workflow/skills/execution_logs/.gitkeep

# Workspace (temporary files)
workspace/*
!workspace/.gitkeep

# Archive
archive/*
!archive/.gitkeep

# Artifacts (keep structure but not content)
artifacts/*.log
artifacts/*.tmp
artifacts/cache/

# Local configuration overrides
.workflow/config.local.yaml
.workflow/secrets.yaml

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb

