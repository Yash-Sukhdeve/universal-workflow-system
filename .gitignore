*.tmp
*.bak
*.backup
tmp/
temp/

# Vector memory database (local, per-project)
memory/

# Security
*.key
*.pem
*.crt
.env.local
.env.production
secrets/
credentials/

# Workflow system
.workflow/agents/memory/*
.workflow/*.tmp
workspace/*
!workspace/.gitkeep

# UWS framework runtime scaffolding (transient; regenerated by the workflow)
.uws/
NOTIFICATIONS.md
.workflow.backup.*
.workflow/*.bak-*
.workflow/**/*.bak-*

# --- Snapshot path fix + transient runtime state ---
# Checkpoint snapshots are local restore points, not source. The old rule above
# used the wrong path (.workflow/snapshots/*); the real path is nested:
.workflow/checkpoints/snapshots/*
# Per-session agent/skill runtime state (churns every run; catalog.yaml + registry.yaml
# remain the tracked sources of truth):
.workflow/agents/active.yaml
.workflow/agents/events.json
.workflow/agents/sessions.yaml
.workflow/skills/definitions/
.workflow/skills/enabled.yaml
.workflow/knowledge/
# Root convenience launcher (canonical CLI is tracked at bin/uws):
/uws

# Test-run artifacts (mock shims + temp workflow dir regenerated by BATS):
tests/.workflow/
tests/scripts/
tests/bin/

# Separate tools / editor caches (not part of UWS source):
.staf/
STAF_QUICKREF.md
.playwright-mcp/
company_os/dashboard/.vite/
company_os/dashboard/test-results/

# Local agent settings + atomic-write temp files (user-local, never source):
.claude/settings.local.json
.claude/settings.local.json.tmp.*
